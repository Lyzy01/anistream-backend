# Server
PORT=8080
NODE_ENV=development

# CORS - comma separated list of allowed origins.
# For local Expo dev this usually includes exp://, http://localhost:8081, and your tunnel URL.
CORS_ORIGINS=*

# Jikan (MyAnimeList) public API
JIKAN_BASE_URL=https://api.jikan.moe/v4

# Cache / rate limit tuning (kept low to respect Render free tier + Jikan's own rate limits)
CACHE_TTL_SECONDS=600
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Firebase Admin SDK (for verifying ID tokens on protected routes, e.g. syncing watch progress server-side)
# Generate a service account key from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
